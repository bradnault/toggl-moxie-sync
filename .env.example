# Copy to `.env` and fill in. `.env` should be gitignored. You fill these in
# yourself — Claude never handles your keys.

# --- Toggl Track (read) ---
# Toggl Track > Profile settings > API Token ("Click to reveal").
TOGGL_API_TOKEN=

# --- Moxie (write) ---
# From Moxie: Settings > Apps & integrations > Custom Integration (REST/Public API).
# Base URL is your pod host + /api/public, e.g. https://pod01.withmoxie.com/api/public
MOXIE_BASE_URL=
MOXIE_API_KEY=
MOXIE_USER_EMAIL=brad@signalpathcreative.com

# --- Behavior ---
# SAFE DEFAULT: 1 = dry run (log only, no writes). Set to 0 to go live.
SYNC_DRY_RUN=1
# How many days back to look each run (overlap is fine; dedupe prevents doubles).
SYNC_LOOKBACK_DAYS=10
# At cutover, set this to the date you turn Zapier off (YYYY-MM-DD or ISO), so the
# sync only creates entries from that point on and never re-creates Zapier history.
SYNC_ONLY_AFTER=
